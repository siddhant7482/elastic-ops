# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # for the ingest token

# Shared secret the collectors send as X-Ingest-Token.
# Without it, backup state and host metrics cannot be posted in.
OPS_INGEST_TOKEN=

# Matrix access token for alerting. Get one with:
#   python3 app.py checks.toml --matrix-login
OPS_MATRIX_TOKEN=

# Where alerts go. Empty means they are logged but never sent.
OPS_WEBHOOK_URL=
OPS_WEBHOOK_HEADER=

# External dead-man's switch, e.g. a healthchecks.io ping URL.
# Without it, nothing tells you when the checker itself has died.
OPS_DEADMAN_URL=
